ASV_CONNECTION_STRING=/dev/ttyACM0
ASV_BAUDRATE=115200

# ========================
# BACKEND
# ========================
# Server terhosting (dipakai sekarang). WAJIB wss:// dan https:// —
# sertifikat TLS terpasang di nginx, http:// polos akan ditolak/redirect.
ASV_WS_URL=wss://bluefin.autos/api/v1/ws/asv
ASV_VIDEO_URL=https://bluefin.autos/api/v1/video/upload
ASV_PID_CONFIG_URL=https://bluefin.autos/api/v1/pid-config

# Alternatif saat backend dijalankan langsung di laptop base station (satu LAN
# dengan Mini PC kapal). Ganti nama host sesuai `hostname` laptop tersebut.
# ASV_WS_URL=ws://bodrex-Legion-5-16IRX9.local:3000/api/v1/ws/asv
# ASV_VIDEO_URL=http://bodrex-Legion-5-16IRX9.local:3000/api/v1/video/upload
# ASV_PID_CONFIG_URL=http://bodrex-Legion-5-16IRX9.local:3000/api/v1/pid-config
