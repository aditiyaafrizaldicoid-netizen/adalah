ASV_CONNECTION_STRING=/dev/ttyACM0
ASV_BAUDRATE=115200

# ========================
# BACKEND
# ========================
# Server terhosting (dipakai sekarang). WAJIB wss:// dan https:// —
# sertifikat TLS terpasang di nginx, http:// polos akan ditolak/redirect.
ASV_WS_URL=wss://bluefin.autos/api/v1/ws/asv
ASV_VIDEO_URL=https://bluefin.autos/api/v1/video/upload
ASV_PID_CONFIG_URL=https://bluefin.autos/api/v1/pid-config

# Alternatif saat backend dijalankan langsung di laptop base station (satu LAN
# dengan Mini PC kapal). Ganti nama host sesuai `hostname` laptop tersebut.
# ASV_WS_URL=ws://bodrex-Legion-5-16IRX9.local:3000/api/v1/ws/asv
# ASV_VIDEO_URL=http://bodrex-Legion-5-16IRX9.local:3000/api/v1/video/upload
# ASV_PID_CONFIG_URL=http://bodrex-Legion-5-16IRX9.local:3000/api/v1/pid-config


# ========================
# KUNCI BERSAMA KE BASE STATION
# ========================
# Memagari /ws/asv dan /video/upload di backend. Harus SAMA PERSIS dengan
# ASV_WS_TOKEN di asv-backend/.env.
#
# Dikosongkan = kedua endpoint itu terbuka tanpa pemeriksaan, seperti perilaku
# lama. Ini disengaja supaya kapal yang belum di-deploy ulang tidak mendadak
# gagal konek — tapi artinya siapa pun yang bisa menjangkau backend dapat
# menyamar sebagai kapal dan menyuntikkan telemetri atau gambar palsu.
# Isi di KEDUA sisi sebelum dipakai di jaringan yang tidak kamu kendalikan.
#
# Bangkitkan sekali dengan:  openssl rand -hex 32
ASV_WS_TOKEN=

# Alamat unggah foto misi ber-geo-tag hasil step PHOTO_BOX. Tanpa ini, foto tetap
# tersimpan di kapal (flightcontrolAsv1/captures/) tapi tidak muncul di dashboard.
ASV_CAPTURE_URL=https://bluefin.autos/api/v1/captures

# ========================
# SWITCH SUMBER KENDALI DI REMOTE (FS-i6X SwD)
# ========================
# Nomor channel RC yang membawa posisi switch pemindah sumber kendali.
# KOSONG / 0 = fitur nonaktif, sumber kendali hanya bisa dipindah dari dashboard.
#
# Cara menyiapkan di FS-i6X:
#   1. Functions -> Aux. channels -> pilih channel (mis. Ch 8), sumber = SwD
#   2. Mission Planner -> Radio Calibration: gerakkan SwD, pastikan bar channel
#      itu ikut bergerak (kalau tidak, Pixhawk tidak menerimanya)
#   3. Isi nomor channel itu di bawah
ASV_RC_SOURCE_CHANNEL=
# PWM TINGGI = REMOTE (default). Isi 1 untuk membalik arahnya.
ASV_RC_SOURCE_INVERT=0
