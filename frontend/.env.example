# Alamat backend Go (REST + WebSocket + stream kamera).
# Seluruh frontend membaca ini lewat src/config/api.js — tidak ada lagi alamat
# yang ditulis langsung di komponen. Ganti ke IP base station kalau halaman
# dibuka dari perangkat lain, mis. VITE_API_URL=http://192.168.1.10:3000
#
# Catatan: Vite hanya membaca berkas ini saat dev server START. Setelah diubah,
# hentikan dan jalankan ulang `npm run dev` — hot reload tidak cukup.
VITE_API_URL=http://localhost:3000

# Access token Mapbox (peta GridMap). Ambil di https://account.mapbox.com/access-tokens/
# Token PUBLIK (awalan pk.) sudah cukup — token inilah yang memang ditujukan untuk
# dipakai di browser. JANGAN memakai token rahasia (sk.): berkas bundel frontend
# bisa dibaca siapa pun yang membuka halaman ini.
#
# Batasi token lewat URL restriction di dasbor Mapbox ke alamat base station saja,
# supaya kuota tidak terpakai orang lain kalau token sempat terlihat.
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
