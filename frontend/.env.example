# Alamat backend Go (REST + WebSocket + stream kamera).
# Seluruh frontend membaca ini lewat src/config/api.js — tidak ada lagi alamat
# yang ditulis langsung di komponen. Ganti ke IP base station kalau halaman
# dibuka dari perangkat lain, mis. VITE_API_URL=http://192.168.1.10:3000
#
# Catatan: Vite hanya membaca berkas ini saat dev server START. Setelah diubah,
# hentikan dan jalankan ulang `npm run dev` — hot reload tidak cukup.
VITE_API_URL=http://localhost:3000
